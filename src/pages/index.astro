---
import Layout from '../layouts/Layout.astro';
import Stats from '../components/Stats.astro';
import MathTip from '../components/MathTip.astro';
import Features from '../components/Features.astro';
import CourseGridHome from '../components/CourseGridHome.astro';
import TeachersHome from '../components/TeachersHome.astro';
import HowItWorks from '../components/HowItWorks.astro';
import FAQ from '../components/FAQ.astro';
import Newsletter from '../components/Newsletter.astro';
import Testimonials from '../components/Testimonials.astro';
import CTA from '../components/CTA.astro';
import WhatsAppFAB from '../components/WhatsAppFAB.astro';
---

<Layout title="الرئيسية">
  <main class="relative">
    <!-- Hero Section -->
    <section class="relative pt-32 pb-20 overflow-hidden min-h-[90vh] flex items-center">
      <!-- Decorative blobs -->
      <div class="absolute top-1/4 -right-20 w-96 h-96 bg-purple-400/30 rounded-full mix-blend-multiply filter blur-3xl opacity-70"></div>
      <div class="absolute top-1/3 -left-20 w-72 h-72 bg-rose-400/30 rounded-full mix-blend-multiply filter blur-3xl opacity-70"></div>
      
      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/80 dark:bg-slate-800/80 backdrop-blur-sm border border-purple-100 dark:border-purple-900/30 shadow-sm mb-8 hover:scale-105 transition-transform cursor-pointer">
            <span class="flex h-2.5 w-2.5 rounded-full bg-purple-600 animate-ping"></span>
            <span class="flex h-2.5 w-2.5 rounded-full bg-purple-600 absolute"></span>
            <span class="text-sm font-semibold text-purple-900 dark:text-purple-200 mr-2">المنصة الأولى للتعليم عن بعد بالمملكة</span>
          </div>
          
          <h1 class="text-5xl md:text-7xl lg:text-8xl font-black mb-6 leading-tight text-slate-900 dark:text-white">
            رحلتك نحو التفوق <br/>
            <span class="text-gradient inline-block mt-2">تبدأ من هنا</span>
          </h1>
          
          <p class="text-lg md:text-2xl text-slate-600 dark:text-slate-300 mb-10 leading-relaxed max-w-3xl mx-auto font-semibold">
            نخبة من أفضل المعلمين والمعلمات، دروس تفاعلية، ومتابعة مستمرة لضمان تميزك الدراسي في جميع المراحل.
          </p>
          
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/courses" class="px-8 py-4 rounded-2xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-700 hover:to-indigo-700 text-white font-bold text-xl transition-all shadow-xl shadow-purple-600/30 hover:-translate-y-1 hover:shadow-2xl hover:shadow-purple-600/40">
              استكشف الدورات
            </a>
            <a href="/contact" class="px-8 py-4 rounded-2xl bg-white dark:bg-slate-800 text-slate-900 dark:text-white font-bold text-xl border border-slate-200 dark:border-slate-700 hover:border-purple-300 dark:hover:border-purple-700 transition-all shadow-sm hover:-translate-y-1 hover:shadow-md flex items-center justify-center gap-2">
              تواصل معنا
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <Stats />
    <MathTip />
    <Features />
    <CourseGridHome />
    <TeachersHome />
    <div id="how-it-works">
      <HowItWorks />
    </div>
    <Testimonials />
    <FAQ />
    <Newsletter />
    <CTA />
  </main>
  
  <WhatsAppFAB />
</Layout>
