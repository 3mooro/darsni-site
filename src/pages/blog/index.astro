---
import Layout from '../../layouts/Layout.astro';

let posts = [];
try {
  const { env } = await import('cloudflare:workers');
  const db = env?.DB;
  if (db) {
    const { results } = await db.prepare("SELECT * FROM blog ORDER BY created_at DESC").all();
    posts = (results || []).map(row => ({
      id: row.slug || row.id,
      data: {
        title: row.title,
        description: row.description || row.title,
        pubDate: new Date(row.created_at || Date.now()),
        heroImage: row.heroImage || null,
        author: row.author || 'أكاديمية درسني',
        readingTime: row.readingTime || '5 دقائق'
      }
    }));
  }
} catch (e) {
  console.error(e);
}
---

<Layout title="المدونة | Blog">
  <main dir="rtl" class="min-h-screen bg-slate-50 dark:bg-slate-900 transition-colors duration-300">
    <div class="relative py-20 overflow-hidden">
      <!-- Gradient Background Elements -->
      <div class="absolute top-0 -left-4 w-72 h-72 bg-purple-500 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-blob"></div>
      <div class="absolute top-0 -right-4 w-72 h-72 bg-indigo-500 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-blob" style="animation-delay: 2s;"></div>
      <div class="absolute -bottom-8 left-20 w-72 h-72 bg-rose-500 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-blob" style="animation-delay: 4s;"></div>

      <div class="container mx-auto px-4 relative z-10">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <h1 class="text-5xl md:text-6xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-purple-600 via-indigo-600 to-rose-600 dark:from-purple-400 dark:via-indigo-400 dark:to-rose-400 mb-6 drop-shadow-sm">
            أحدث المقالات
          </h1>
          <p class="text-lg text-slate-600 dark:text-slate-300">
            استكشف أحدث الأخبار والمقالات والنصائح في مجال التعليم.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map((post) => (
            <a href={`/blog/${post.id}`} class="group relative block h-full rounded-2xl bg-white/70 dark:bg-slate-800/70 backdrop-blur-md border border-slate-200/50 dark:border-slate-700/50 p-1 transition-all duration-300 hover:shadow-2xl hover:shadow-purple-500/10 hover:-translate-y-2 overflow-hidden">
              <div class="absolute inset-0 bg-gradient-to-br from-purple-500/5 via-indigo-500/5 to-rose-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              
              {post.data.heroImage ? (
                <div class="relative h-56 overflow-hidden rounded-xl mb-4">
                  <img src={post.data.heroImage} alt={post.data.title} class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500" />
                </div>
              ) : (
                <div class="relative h-56 overflow-hidden rounded-xl mb-4 bg-gradient-to-br from-purple-100 to-indigo-100 dark:from-purple-900/40 dark:to-indigo-900/40 flex items-center justify-center">
                  <span class="text-4xl">📝</span>
                </div>
              )}
              
              <div class="p-6">
                <div class="flex items-center gap-2 mb-3">
                  <span class="text-xs font-semibold px-3 py-1 bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 rounded-full">
                    {post.data.author || 'KSA Academy'}
                  </span>
                  {post.data.readingTime && (
                    <span class="text-xs text-slate-500 dark:text-slate-400">
                      • {post.data.readingTime}
                    </span>
                  )}
                </div>
                
                <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-3 group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
                  {post.data.title}
                </h2>
                
                <p class="text-slate-600 dark:text-slate-300 line-clamp-3 mb-4">
                  {post.data.description}
                </p>
                
                <div class="flex items-center justify-between mt-auto pt-4 border-t border-slate-200 dark:border-slate-700/50">
                  <time datetime={post.data.pubDate.toISOString()} class="text-sm text-slate-500 dark:text-slate-400 font-medium">
                    {new Date(post.data.pubDate).toLocaleDateString('ar-SA', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric'
                    })}
                  </time>
                  <div class="text-purple-600 dark:text-purple-400 font-bold group-hover:-translate-x-1 transition-transform flex items-center">
                    اقرأ المزيد
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                  </div>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  @keyframes blob {
    0% { transform: translate(0px, 0px) scale(1); }
    33% { transform: translate(30px, -50px) scale(1.1); }
    66% { transform: translate(-20px, 20px) scale(0.9); }
    100% { transform: translate(0px, 0px) scale(1); }
  }
  .animate-blob {
    animation: blob 7s infinite;
  }
</style>
