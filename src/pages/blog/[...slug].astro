---
import Layout from '../../layouts/Layout.astro';
import { marked } from 'marked';

const { slug } = Astro.params;

let post = null;
try {
  const { env } = await import('cloudflare:workers');
  const db = env?.DB;
  if (db) {
    post = await db.prepare('SELECT * FROM blog WHERE slug = ?').bind(slug).first();
  }
} catch (e) {
  console.error(e);
}

if (!post) {
  return Astro.redirect('/404');
}

let tags = [];
try {
  tags = post.tags ? JSON.parse(post.tags) : [];
} catch(e) {}

let relatedPosts = [];
try {
  const { env } = await import('cloudflare:workers');
  const db = env?.DB;
  if (db) {
    const { results } = await db.prepare('SELECT * FROM blog WHERE slug != ? ORDER BY RANDOM() LIMIT 3').bind(slug).all();
    relatedPosts = results || [];
  }
} catch (e) {}

const title = post.title;
const author = post.author || 'أكاديمية درسني';
const pubDate = new Date(post.created_at || Date.now());
const readingTime = post.readingTime || '5 دقائق';
const heroImage = post.heroImage;
---

<Layout title={`${title} | المدونة`}>
  <article dir="rtl" class="min-h-screen bg-slate-50 dark:bg-slate-900 pb-20 transition-colors duration-300">
    <div class="relative">
      <!-- Background Gradients -->
      <div class="absolute inset-x-0 top-0 h-[60vh] bg-gradient-to-b from-purple-100/50 via-indigo-50/50 to-transparent dark:from-purple-900/20 dark:via-indigo-900/10 dark:to-transparent -z-10"></div>
      
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <header class="text-center pt-24 pb-12">
          {tags && tags.length > 0 && (
            <div class="flex justify-center flex-wrap gap-2 mb-8">
              {tags.map((tag: string) => (
                <span class="px-4 py-1.5 text-sm font-medium bg-rose-100/80 dark:bg-rose-900/30 text-rose-700 dark:text-rose-300 rounded-full border border-rose-200/50 dark:border-rose-800/50 backdrop-blur-sm shadow-sm">
                  {tag}
                </span>
              ))}
            </div>
          )}
          
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-slate-900 dark:text-white mb-8 leading-tight">
            {title}
          </h1>
          
          <div class="flex flex-wrap items-center justify-center gap-6 text-slate-600 dark:text-slate-400 font-medium">
            <div class="flex items-center gap-2">
              <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-purple-500 to-indigo-500 flex items-center justify-center text-white text-lg font-bold shadow-md ring-2 ring-white dark:ring-slate-800">
                {author.charAt(0)}
              </div>
              <span class="text-lg">{author}</span>
            </div>
            
            <div class="w-1.5 h-1.5 rounded-full bg-slate-300 dark:bg-slate-700"></div>
            
            <time datetime={pubDate.toISOString()} class="flex items-center gap-2 text-lg">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              {pubDate.toLocaleDateString('ar-SA', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </time>
            
            {readingTime && (
              <>
                <div class="w-1.5 h-1.5 rounded-full bg-slate-300 dark:bg-slate-700"></div>
                <div class="flex items-center gap-2 text-lg">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  {readingTime}
                </div>
              </>
            )}
          </div>
        </header>

        {heroImage && (
          <div class="mb-16 relative group">
            <div class="absolute -inset-2 bg-gradient-to-r from-purple-500 via-indigo-500 to-rose-500 rounded-[2rem] blur opacity-20 group-hover:opacity-30 transition duration-500"></div>
            <img 
              src={heroImage} 
              alt={title} 
              class="relative w-full h-auto max-h-[600px] object-cover rounded-3xl shadow-2xl ring-1 ring-slate-900/5 dark:ring-white/10" 
            />
          </div>
        )}

        <div class="bg-white/80 dark:bg-slate-800/80 backdrop-blur-xl border border-slate-200/50 dark:border-slate-700/50 rounded-3xl p-8 md:p-12 shadow-xl shadow-purple-500/5">
          <div class="prose prose-lg md:prose-xl prose-slate dark:prose-invert max-w-none 
            prose-headings:font-bold prose-headings:text-slate-900 dark:prose-headings:text-white
            prose-a:!text-purple-600 dark:prose-a:!text-purple-400 prose-a:!underline hover:prose-a:text-purple-700
            prose-img:rounded-2xl prose-img:shadow-lg
            prose-strong:text-slate-900 dark:prose-strong:text-white prose-strong:font-bold
            prose-blockquote:border-r-4 prose-blockquote:border-l-0 prose-blockquote:border-purple-500 
            prose-blockquote:bg-purple-50/50 dark:prose-blockquote:bg-purple-900/20 
            prose-blockquote:px-6 prose-blockquote:py-3 prose-blockquote:rounded-l-xl prose-blockquote:font-medium prose-blockquote:italic
            marker:text-purple-500" set:html={post.body}>
          </div>
        </div>
        
        <div class="mt-16 text-center">
          <a href="/blog" class="inline-flex items-center justify-center gap-2 px-8 py-4 text-lg font-bold text-white bg-gradient-to-r from-purple-600 to-indigo-600 rounded-full shadow-lg shadow-purple-500/30 hover:shadow-purple-500/50 hover:-translate-y-1 transition-all duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
            العودة للمدونة
          </a>
        </div>

        {relatedPosts && relatedPosts.length > 0 && (
          <div class="mt-24 pt-12 border-t border-slate-200/50 dark:border-slate-800/50">
            <h3 class="text-3xl font-bold text-slate-900 dark:text-white mb-8">مقالات ذات صلة</h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              {relatedPosts.map((rp: any) => (
                <a href={`/blog/${rp.slug}`} class="group bg-white/80 dark:bg-slate-800/80 backdrop-blur-xl border border-slate-200/50 dark:border-slate-700/50 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:shadow-purple-500/10 transition-all duration-300 hover:-translate-y-1 flex flex-col h-full">
                  <div class="h-48 overflow-hidden relative w-full">
                    <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 to-transparent z-10"></div>
                    <img src={rp.heroImage || '/og-image.jpg'} alt={rp.title} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                  </div>
                  <div class="p-6 flex-1 flex flex-col justify-between">
                    <h4 class="font-bold text-lg text-slate-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors line-clamp-2">{rp.title}</h4>
                    <span class="inline-block mt-4 text-sm text-purple-600 dark:text-purple-400 font-semibold group-hover:underline">اقرأ المزيد &larr;</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

      </div>
    </div>
  </article>
</Layout>

<style is:global>
  .prose a {
    color: #9333ea !important; /* purple-600 */
    text-decoration: underline !important;
  }
  html.dark .prose a {
    color: #c084fc !important; /* purple-400 */
  }
  .prose a:hover {
    color: #7e22ce !important; /* purple-700 */
  }
</style>
