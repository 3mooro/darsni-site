---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const courses = await getCollection('courses');
---

<Layout title="حجز حصة">
  <div class="min-h-screen pt-32 pb-20 px-4">
    <div class="container mx-auto max-w-4xl relative z-10">
      
      <div class="text-center mb-12">
        <span class="inline-block px-4 py-1.5 rounded-full bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 font-bold text-sm mb-4 border border-purple-200 dark:border-purple-800">
          حجز مباشر
        </span>
        <h1 class="text-4xl md:text-5xl font-black text-slate-900 dark:text-white mb-4">احجز حصتك الآن</h1>
        <p class="text-lg text-slate-600 dark:text-slate-400 font-semibold">اختر المادة والوقت المناسب لك، وسنقوم بتأكيد الحجز فوراً</p>
      </div>

      <div class="bg-white dark:bg-slate-900 rounded-[2.5rem] shadow-2xl shadow-purple-500/10 border border-slate-200 dark:border-slate-800 p-8 md:p-12">
        <form class="space-y-8">
          
          <!-- Course Selection -->
          <div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
              <span class="w-8 h-8 rounded-full bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 flex items-center justify-center">1</span>
              اختر المادة
            </h3>
            <select required class="w-full px-5 py-4 rounded-2xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 outline-none transition-all dark:text-white appearance-none font-bold">
              <option value="" disabled selected>اختر الكورس أو المادة المطلوبة...</option>
              {courses.map(course => (
                <option value={course.id}>{course.data.title} - ({course.data.level})</option>
              ))}
            </select>
          </div>

          <!-- Package Selection -->
          <div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
              <span class="w-8 h-8 rounded-full bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 flex items-center justify-center">2</span>
              الباقة المطلوبة
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <label class="cursor-pointer relative">
                <input type="radio" name="package" value="urgent" class="peer sr-only" required>
                <div class="p-6 rounded-2xl border-2 border-slate-200 dark:border-slate-700 peer-checked:border-purple-500 peer-checked:bg-purple-50 dark:peer-checked:bg-purple-900/20 transition-all text-center">
                  <div class="text-lg font-bold text-slate-900 dark:text-white mb-1">حصة طارئة</div>
                  <div class="text-sm text-slate-500 dark:text-slate-400">حصة واحدة مراجعة</div>
                </div>
              </label>
              
              <label class="cursor-pointer relative">
                <input type="radio" name="package" value="bundle-2" class="peer sr-only">
                <div class="p-6 rounded-2xl border-2 border-slate-200 dark:border-slate-700 peer-checked:border-purple-500 peer-checked:bg-purple-50 dark:peer-checked:bg-purple-900/20 transition-all text-center">
                  <div class="text-lg font-bold text-slate-900 dark:text-white mb-1">باقة حصتين</div>
                  <div class="text-sm text-slate-500 dark:text-slate-400">مثالية للأساسيات</div>
                </div>
              </label>
              
              <label class="cursor-pointer relative">
                <input type="radio" name="package" value="bundle-8" class="peer sr-only">
                <div class="p-6 rounded-2xl border-2 border-purple-500 bg-purple-50 dark:bg-purple-900/10 peer-checked:bg-purple-100 dark:peer-checked:bg-purple-900/30 transition-all text-center relative overflow-hidden">
                  <div class="absolute top-0 right-0 bg-rose-500 text-white text-[10px] font-bold px-2 py-1 rounded-bl-lg">الأكثر توفيراً</div>
                  <div class="text-lg font-bold text-slate-900 dark:text-white mb-1">باقة 8 حصص</div>
                  <div class="text-sm text-purple-600 dark:text-purple-400 font-bold">تأسيس ومتابعة كاملة</div>
                </div>
              </label>
            </div>
          </div>

          <!-- Date & Time -->
          <div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
              <span class="w-8 h-8 rounded-full bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 flex items-center justify-center">3</span>
              الوقت المفضل
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <input type="date" required class="w-full px-5 py-4 rounded-2xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 outline-none transition-all dark:text-white font-bold" />
              <select required class="w-full px-5 py-4 rounded-2xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 outline-none transition-all dark:text-white appearance-none font-bold">
                <option value="" disabled selected>الفترة المفضلة...</option>
                <option value="morning">صباحاً (8 ص - 12 م)</option>
                <option value="afternoon">عصراً (1 م - 4 م)</option>
                <option value="evening">مساءً (5 م - 9 م)</option>
              </select>
            </div>
          </div>
          
          <div class="pt-4 border-t border-slate-200 dark:border-slate-700">
            <button type="submit" class="w-full py-5 rounded-2xl bg-gradient-to-r from-purple-600 to-indigo-600 text-white font-black text-xl hover:from-purple-700 hover:to-indigo-700 transition-all shadow-xl shadow-purple-500/30 hover:shadow-purple-500/50 hover:-translate-y-1 flex items-center justify-center gap-3">
              تأكيد حجز الحصة
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>
          </div>

        </form>
      </div>
    </div>
  </div>
</Layout>
