---
import { env } from 'cloudflare:workers';

let whatsappNumber = '966500000000';
try {
  const db = env?.DB;
  if (db) {
    const res = await db.prepare("SELECT whatsapp_number FROM site_settings LIMIT 1").first();
    if (res && res.whatsapp_number) {
      whatsappNumber = res.whatsapp_number;
    }
  }
} catch (e) {
  console.error('Could not fetch whatsapp number from DB:', e);
}

return Astro.redirect(`https://wa.me/${whatsappNumber}`);
---
