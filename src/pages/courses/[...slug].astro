---
import Layout from '../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';

const { slug } = Astro.params;
let course = null;

try {
  const db = env?.DB;
  if (db) {
    course = await db.prepare('SELECT * FROM courses WHERE slug = ?').bind(slug).first();
  }
} catch (e) {
  console.error(e);
}

if (!course) {
  return Astro.redirect('/404');
}

const title = course.title;
const instructor = course.instructor || 'أكاديمية درسني';
const rating = course.rating || '5.0';
const image = course.image || `https://placehold.co/800x600/9333ea/ffffff?text=${encodeURIComponent(title)}`;
const level = course.level || 'other';
const tag = course.tag || 'جديد';
const description = course.body || '';

let syllabus = [];
let packages = [];
try {
  if (course.syllabus) syllabus = JSON.parse(course.syllabus);
  if (course.packages) packages = JSON.parse(course.packages);
} catch(e) {}
---

<Layout title={title}>
  <div class="relative py-20 overflow-hidden">
    <!-- Hero Background -->
    <div class="absolute inset-0 bg-gradient-to-br from-slate-900 to-slate-800 -z-20"></div>
    <div class="absolute inset-0 bg-[url('/noise.png')] opacity-10 mix-blend-overlay -z-20"></div>
    <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-purple-500/20 blur-[120px] rounded-full -z-10 translate-x-1/2 -translate-y-1/2"></div>
    <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-indigo-500/20 blur-[100px] rounded-full -z-10 -translate-x-1/2 translate-y-1/2"></div>

    <div class="container mx-auto px-4 pt-10 pb-20">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <!-- Content -->
        <div class="text-white space-y-6">
          <div class="flex flex-wrap items-center gap-3">
            <span class="px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-sm font-medium">
              {tag}
            </span>
            <div class="flex items-center gap-1.5 px-4 py-1.5 rounded-full bg-amber-500/20 border border-amber-500/30 text-amber-300 text-sm font-medium">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
              {rating}
            </div>
          </div>
          
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-black leading-tight bg-clip-text text-transparent bg-gradient-to-r from-white to-white/70">
            {title}
          </h1>
          
          {description && (
            <p class="text-lg text-slate-300 leading-relaxed max-w-xl">
              {description}
            </p>
          )}
          
          <div class="flex items-center gap-4 pt-4">
            <div class="w-14 h-14 rounded-full bg-gradient-to-br from-purple-400 to-indigo-500 p-[2px]">
              <div class="w-full h-full rounded-full bg-slate-900 flex items-center justify-center text-white text-xl font-bold">
                {instructor.charAt(0)}
              </div>
            </div>
            <div>
              <p class="text-sm text-slate-400 mb-1">تقديم الأستاذ</p>
              <p class="text-lg font-bold text-white">{instructor}</p>
            </div>
          </div>
        </div>

        <!-- Image -->
        <div class="relative group">
          <div class="absolute -inset-1 bg-gradient-to-r from-purple-600 to-indigo-600 rounded-3xl blur opacity-25 group-hover:opacity-50 transition duration-1000 group-hover:duration-200"></div>
          <div class="relative rounded-3xl overflow-hidden aspect-[4/3] shadow-2xl border border-white/10">
            <img src={image} alt={title} class="w-full h-full object-cover" />
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="container mx-auto px-4 py-20">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <!-- Left Column (Syllabus) -->
      <div class="lg:col-span-2 space-y-12">
        {syllabus && syllabus.length > 0 && (
          <section>
            <div class="flex items-center gap-4 mb-8">
              <div class="w-12 h-12 rounded-2xl bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center text-purple-600 dark:text-purple-400 shadow-inner">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
              </div>
              <h2 class="text-3xl font-bold text-slate-900 dark:text-white">المنهج الدراسي</h2>
            </div>
            
            <div class="space-y-4">
              {syllabus.map((unit, index) => (
                <div class="accordion-item bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl overflow-hidden shadow-sm transition-all duration-300 hover:shadow-md hover:border-purple-200 dark:hover:border-purple-800/50">
                  <button class="accordion-header w-full flex items-center justify-between p-5 md:p-6 text-right focus:outline-none">
                    <div class="flex items-center gap-4">
                      <span class="flex items-center justify-center w-8 h-8 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 font-bold text-sm">
                        {index + 1}
                      </span>
                      <span class="text-lg font-bold text-slate-800 dark:text-slate-100">{unit.unit}</span>
                    </div>
                    <span class="accordion-icon w-8 h-8 flex items-center justify-center rounded-full bg-slate-50 dark:bg-slate-800 text-slate-400 transition-transform duration-300">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                      </svg>
                    </span>
                  </button>
                  <div class="accordion-content h-0 overflow-hidden transition-all duration-300">
                    <div class="p-5 md:p-6 pt-0 border-t border-slate-100 dark:border-slate-800">
                      <ul class="space-y-3">
                        {unit.lessons.map(lesson => (
                          <li class="flex items-start gap-3 text-slate-600 dark:text-slate-300">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-purple-500 mt-0.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                            </svg>
                            <span>{lesson}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}
      </div>

      <!-- Right Column (Packages) -->
      <div>
        {packages && packages.length > 0 && (
          <div class="sticky top-24 space-y-6">
            <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-6">الباقات المتاحة</h3>
            
            {packages.map(pkg => (
              <div class={`relative p-6 rounded-3xl border ${pkg.isUrgent ? 'bg-gradient-to-b from-rose-50 to-white dark:from-rose-900/20 dark:to-slate-900 border-rose-200 dark:border-rose-800/50 shadow-rose-100/50 dark:shadow-rose-900/20' : 'bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-800'} shadow-xl`}>
                {pkg.isUrgent && (
                  <div class="absolute top-0 right-1/2 translate-x-1/2 -translate-y-1/2 bg-gradient-to-r from-rose-500 to-pink-500 text-white px-4 py-1 rounded-full text-xs font-bold shadow-lg shadow-rose-500/30 whitespace-nowrap">
                    الأكثر طلباً
                  </div>
                )}
                
                <h4 class="text-xl font-bold text-slate-900 dark:text-white mb-2">{pkg.name}</h4>
                <div class="flex items-end gap-1 mb-6">
                  <span class="text-3xl font-black text-slate-900 dark:text-white">{pkg.totalPrice}</span>
                  <span class="text-slate-500 dark:text-slate-400 font-medium pb-1">د.ك</span>
                </div>
                
                <div class="space-y-4 mb-8">
                  <div class="flex justify-between text-sm pb-4 border-b border-slate-100 dark:border-slate-800">
                    <span class="text-slate-500 dark:text-slate-400">عدد الحصص</span>
                    <span class="font-bold text-slate-900 dark:text-white">{pkg.sessions} حصص</span>
                  </div>
                  <div class="flex justify-between text-sm pb-4 border-b border-slate-100 dark:border-slate-800">
                    <span class="text-slate-500 dark:text-slate-400">سعر الحصة</span>
                    <span class="font-bold text-slate-900 dark:text-white">{pkg.pricePerSession} د.ك</span>
                  </div>
                  
                  <ul class="space-y-3 pt-2">
                    {pkg.features.map(feature => (
                      <li class="flex items-start gap-2 text-sm text-slate-600 dark:text-slate-300">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-500 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                        </svg>
                        {feature}
                      </li>
                    ))}
                  </ul>
                </div>
                
                <button class={`w-full py-3.5 rounded-xl font-bold transition-all duration-300 shadow-lg ${pkg.isUrgent ? 'bg-gradient-to-r from-rose-500 to-pink-500 hover:from-rose-600 hover:to-pink-600 text-white shadow-rose-500/30' : 'bg-slate-900 hover:bg-slate-800 dark:bg-purple-600 dark:hover:bg-purple-700 text-white shadow-slate-900/20 dark:shadow-purple-600/20'}`}>
                  اشترك الآن
                </button>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</Layout>

<style>
  .accordion-content {
    transition: height 0.3s ease-in-out;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const accordions = document.querySelectorAll('.accordion-item');
    
    accordions.forEach(accordion => {
      const header = accordion.querySelector('.accordion-header');
      const content = accordion.querySelector('.accordion-content');
      const icon = accordion.querySelector('.accordion-icon');
      
      if (header && content && icon) {
        header.addEventListener('click', () => {
          const isOpen = content.classList.contains('is-open');
          
          if (isOpen) {
            content.classList.remove('is-open');
            content.style.height = '0px';
            icon.style.transform = 'rotate(0deg)';
          } else {
            content.classList.add('is-open');
            content.style.height = content.scrollHeight + 'px';
            icon.style.transform = 'rotate(180deg)';
          }
        });
      }
    });
  });
</script>
