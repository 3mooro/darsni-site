---
import CourseCard from './CourseCard.astro';
import { env } from 'cloudflare:workers';

let allCourses = [];
try {
  const db = env?.DB;
  if (db) {
    const { results } = await db.prepare('SELECT * FROM courses ORDER BY display_order ASC, created_at DESC LIMIT 6').all();
    allCourses = (results || []).map(row => ({
      id: row.slug || row.id,
      data: {
        title: row.title,
        instructor: row.instructor || 'أكاديمية درسني',
        rating: row.rating || '5.0',
        image: row.image || `https://placehold.co/600x400/9333ea/ffffff?text=${encodeURIComponent(row.title)}`,
        level: row.level || 'other',
        tag: row.tag || 'جديد'
      }
    }));
  }
} catch (e) {
  console.error(e);
}
---

<section class="py-20" dir="rtl">
  <div class="container mx-auto px-4 max-w-7xl">
    <div class="flex flex-col md:flex-row justify-between items-center mb-12 gap-6">
      <div>
        <h2 class="text-4xl font-extrabold text-slate-800 dark:text-white mb-4">
          أحدث <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-600 to-rose-500">الدورات</span>
        </h2>
        <p class="text-lg text-slate-600 dark:text-slate-400">اختر من بين أفضل الدورات المصممة خصيصاً لك.</p>
      </div>
      
      <!-- Tabs mockup -->
      <div class="flex p-1 bg-slate-100 dark:bg-slate-800 rounded-2xl overflow-hidden shadow-inner flex-wrap justify-center">
        <button class="px-6 py-2 bg-white dark:bg-slate-700 rounded-xl shadow text-purple-600 dark:text-purple-400 font-bold transition-all">الكل</button>
        <button class="px-6 py-2 text-slate-600 dark:text-slate-400 hover:text-purple-600 font-medium transition-all">ابتدائي</button>
        <button class="px-6 py-2 text-slate-600 dark:text-slate-400 hover:text-purple-600 font-medium transition-all">متوسط</button>
        <button class="px-6 py-2 text-slate-600 dark:text-slate-400 hover:text-purple-600 font-medium transition-all">ثانوي</button>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {allCourses.map(course => (
        <CourseCard course={course} />
      ))}
    </div>
    
    <div class="mt-12 text-center">
      <a href="/courses" class="inline-flex items-center justify-center px-8 py-4 text-lg font-bold text-white bg-gradient-to-r from-purple-600 to-indigo-600 rounded-full hover:from-purple-700 hover:to-indigo-700 shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all duration-300 gap-2">
        عرض جميع الدورات
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 rotate-180" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>
  </div>
</section>
