---
// Features.astro
const features = [
  { title: 'أسعار تنافسية', desc: 'باقات تناسب جميع الميزانيات مع جودة تعليمية عالية.', icon: '💰', color: 'from-green-400 to-emerald-500' },
  { title: 'إشراف مستمر', desc: 'متابعة دورية لمستوى الطالب وتقرير شهري لولي الأمر.', icon: '👀', color: 'from-blue-400 to-indigo-500' },
  { title: 'مرونة في الوقت', desc: 'تعلم في أي وقت ومن أي مكان يناسب جدولك.', icon: '⏳', color: 'from-purple-400 to-fuchsia-500' },
  { title: 'جودة استثنائية', desc: 'محتوى مرئي وصوتي عالي الجودة لضمان التركيز.', icon: '⭐', color: 'from-amber-400 to-orange-500' },
  { title: 'نخبة المعلمين', desc: 'أفضل الكوادر التعليمية بخبرات طويلة في التدريس.', icon: '👨‍🏫', color: 'from-rose-400 to-red-500' }
];
---

<section class="py-20 bg-slate-50/50 dark:bg-slate-900/50" dir="rtl">
  <div class="container mx-auto px-4 max-w-7xl">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-4xl font-extrabold text-slate-800 dark:text-white mb-6">
        لماذا تختار <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-600 to-indigo-600">منصتنا؟</span>
      </h2>
      <p class="text-xl text-slate-600 dark:text-slate-400">
        نقدم لك تجربة تعليمية فريدة تجمع بين التكنولوجيا المتطورة والأساليب التربوية الحديثة.
      </p>
    </div>

    <div class="flex flex-wrap justify-center gap-8">
      {features.map((feature) => (
        <div class="w-full md:w-[calc(50%-1rem)] lg:w-[calc(33.333%-1.5rem)] relative group">
          <div class="absolute inset-0 bg-white dark:bg-slate-800 rounded-3xl shadow-xl transition-all duration-300 group-hover:scale-105 group-hover:shadow-2xl"></div>
          <div class="relative p-8 backdrop-blur-sm rounded-3xl border border-slate-100 dark:border-slate-700/50 h-full flex flex-col items-center text-center z-10">
            <div class={`w-20 h-20 rounded-2xl flex items-center justify-center mb-6 bg-gradient-to-br ${feature.color} shadow-lg transform group-hover:rotate-6 transition-transform duration-300`}>
              <span class="text-4xl">{feature.icon}</span>
            </div>
            <h3 class="text-2xl font-bold text-slate-800 dark:text-white mb-4">{feature.title}</h3>
            <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
              {feature.desc}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
