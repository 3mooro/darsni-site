<section class="py-20 bg-slate-50 dark:bg-slate-900 relative overflow-hidden" dir="rtl">
  <!-- Background Decorations -->
  <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none">
    <div class="absolute top-[-10%] right-[-5%] w-96 h-96 bg-purple-300 dark:bg-purple-900/30 rounded-full mix-blend-multiply filter blur-3xl opacity-70 animate-pulse"></div>
    <div class="absolute top-[20%] left-[-10%] w-72 h-72 bg-rose-300 dark:bg-rose-900/30 rounded-full mix-blend-multiply filter blur-3xl opacity-70 animate-pulse" style="animation-delay: 2s;"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-purple-600 to-rose-600 dark:from-purple-400 dark:to-rose-400 mb-4">كيف تعمل المنصة؟</h2>
      <p class="text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto">خطوات بسيطة تفصلك عن بدء رحلة التعلم مع أفضل المعلمين</p>
    </div>

    <div class="relative">
      <!-- Connecting line for desktop -->
      <div class="hidden md:block absolute top-1/2 right-[10%] w-[80%] h-1 bg-gradient-to-l from-purple-200 via-rose-200 to-indigo-200 dark:from-purple-800/50 dark:via-rose-800/50 dark:to-indigo-800/50 transform -translate-y-1/2 rounded-full"></div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
        <!-- Step 1 -->
        <div class="relative flex flex-col items-center group">
          <div class="w-20 h-20 bg-white/80 dark:bg-slate-800/80 backdrop-blur-md rounded-2xl shadow-xl shadow-purple-500/10 border border-purple-100 dark:border-purple-900/50 flex items-center justify-center z-10 mb-6 group-hover:scale-110 transition-transform duration-300">
            <span class="text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-br from-purple-600 to-indigo-600">1</span>
          </div>
          <h3 class="text-2xl font-bold text-slate-800 dark:text-white mb-3 text-center">سجل حسابك</h3>
          <p class="text-slate-600 dark:text-slate-400 text-center">أنشئ حساباً مجانياً في ثوانٍ وانضم إلى آلاف الطلاب في منصتنا.</p>
        </div>

        <!-- Step 2 -->
        <div class="relative flex flex-col items-center group">
          <div class="w-20 h-20 bg-white/80 dark:bg-slate-800/80 backdrop-blur-md rounded-2xl shadow-xl shadow-rose-500/10 border border-rose-100 dark:border-rose-900/50 flex items-center justify-center z-10 mb-6 group-hover:scale-110 transition-transform duration-300">
            <span class="text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-br from-rose-500 to-purple-600">2</span>
          </div>
          <h3 class="text-2xl font-bold text-slate-800 dark:text-white mb-3 text-center">اختر معلمك</h3>
          <p class="text-slate-600 dark:text-slate-400 text-center">تصفح قائمة المعلمين المتميزين واختر من يناسب أهدافك التعليمية.</p>
        </div>

        <!-- Step 3 -->
        <div class="relative flex flex-col items-center group">
          <div class="w-20 h-20 bg-white/80 dark:bg-slate-800/80 backdrop-blur-md rounded-2xl shadow-xl shadow-indigo-500/10 border border-indigo-100 dark:border-indigo-900/50 flex items-center justify-center z-10 mb-6 group-hover:scale-110 transition-transform duration-300">
            <span class="text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-br from-indigo-500 to-purple-500">3</span>
          </div>
          <h3 class="text-2xl font-bold text-slate-800 dark:text-white mb-3 text-center">ابدأ التعلم</h3>
          <p class="text-slate-600 dark:text-slate-400 text-center">احجز حصتك وابدأ رحلة التفوق والنجاح مع طرق تدريس مبتكرة.</p>
        </div>
      </div>
    </div>
  </div>
</section>
