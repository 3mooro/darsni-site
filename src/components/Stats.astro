---
// Stats.astro
let stats = {
  stats_students: 10000,
  stats_courses: 250,
  stats_success_rate: 98,
  stats_tools: 50
};

import { env } from 'cloudflare:workers';

try {
  const db = env?.DB;
  if (db) {
    const res = await db.prepare("SELECT * FROM site_settings LIMIT 1").first();
    if (res) {
      stats = res;
    }
  }
} catch (e) {
  console.error('Could not fetch stats from DB:', e);
}

const statItems = [
  { id: 1, name: 'طالب وطالبة', value: `+${stats.stats_students}`, icon: '👥' },
  { id: 2, name: 'دورة تعليمية', value: `+${stats.stats_courses}`, icon: '📚' },
  { id: 3, name: 'نسبة النجاح', value: `%${stats.stats_success_rate}`, icon: '🎯' },
  { id: 4, name: 'أداة تعليمية', value: `+${stats.stats_tools}`, icon: '⚙️' },
];
---

<section class="py-16 relative overflow-hidden" dir="rtl">
  <div class="absolute inset-0 bg-gradient-to-br from-indigo-50 to-purple-50 dark:from-slate-900 dark:to-slate-800 -z-10"></div>
  
  <div class="container mx-auto px-4 max-w-7xl">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
      {statItems.map((stat) => (
        <div class="relative group">
          <div class="absolute -inset-0.5 bg-gradient-to-r from-purple-500 to-rose-500 rounded-2xl blur opacity-25 group-hover:opacity-75 transition duration-1000 group-hover:duration-200"></div>
          <div class="relative flex flex-col items-center justify-center p-8 bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl rounded-2xl border border-white/20 dark:border-slate-800/50 shadow-xl hover:-translate-y-2 transition-transform duration-300">
            <span class="text-4xl mb-4">{stat.icon}</span>
            <h3 class="text-4xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-600 to-indigo-600 dark:from-purple-400 dark:to-indigo-400 mb-2">
              {stat.value}
            </h3>
            <p class="text-slate-600 dark:text-slate-400 font-medium text-lg text-center">
              {stat.name}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
