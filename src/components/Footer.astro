<footer class="bg-white dark:bg-slate-950 border-t border-slate-200 dark:border-slate-800 pt-16 pb-8 mt-20 relative overflow-hidden">
  <div class="absolute bottom-0 inset-x-0 h-1 bg-gradient-to-r from-purple-500 via-rose-500 to-indigo-500"></div>
  
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
      <!-- Brand -->
      <div class="col-span-1 md:col-span-1">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-purple-500 to-indigo-600 flex items-center justify-center font-black text-xl text-white shadow-lg shadow-purple-500/30">
            D
          </div>
          <h2 class="font-bold text-2xl leading-tight text-slate-900 dark:text-white">درسني</h2>
        </div>
        <p class="text-slate-500 dark:text-slate-400 mb-6 leading-relaxed">
          أكاديمية درسني هي منصتك الرائدة للتعليم عن بعد، نقدم لك تجربة فريدة تجمع بين التكنولوجيا المتقدمة والمعلمين المتميزين.
        </p>
      </div>

      <!-- Links 1 -->
      <div>
        <h3 class="font-bold text-lg mb-6 text-slate-900 dark:text-white relative inline-block">
          روابط سريعة
          <span class="absolute -bottom-2 right-0 w-1/2 h-1 bg-purple-500 rounded-full"></span>
        </h3>
        <ul class="flex flex-col gap-3">
          <li><a href="/" class="text-slate-500 dark:text-slate-400 hover:text-purple-600 dark:hover:text-purple-400 transition-colors font-semibold">الرئيسية</a></li>
          <li><a href="/courses" class="text-slate-500 dark:text-slate-400 hover:text-purple-600 dark:hover:text-purple-400 transition-colors font-semibold">جميع الدورات</a></li>
          <li><a href="/about" class="text-slate-500 dark:text-slate-400 hover:text-purple-600 dark:hover:text-purple-400 transition-colors font-semibold">من نحن</a></li>
          <li><a href="/contact" class="text-slate-500 dark:text-slate-400 hover:text-purple-600 dark:hover:text-purple-400 transition-colors font-semibold">اتصل بنا</a></li>
        </ul>
      </div>

      <!-- Links 2 -->
      <div>
        <h3 class="font-bold text-lg mb-6 text-slate-900 dark:text-white relative inline-block">
          الدورات
          <span class="absolute -bottom-2 right-0 w-1/2 h-1 bg-rose-500 rounded-full"></span>
        </h3>
        <ul class="flex flex-col gap-3">
          <li><a href="/courses?level=primary" class="text-slate-500 dark:text-slate-400 hover:text-rose-600 dark:hover:text-rose-400 transition-colors font-semibold">المرحلة الابتدائية</a></li>
          <li><a href="/courses?level=middle" class="text-slate-500 dark:text-slate-400 hover:text-rose-600 dark:hover:text-rose-400 transition-colors font-semibold">المرحلة المتوسطة</a></li>
          <li><a href="/courses?level=secondary" class="text-slate-500 dark:text-slate-400 hover:text-rose-600 dark:hover:text-rose-400 transition-colors font-semibold">المرحلة الثانوية</a></li>
          <li><a href="/courses?level=university" class="text-slate-500 dark:text-slate-400 hover:text-rose-600 dark:hover:text-rose-400 transition-colors font-semibold">المرحلة الجامعية</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="font-bold text-lg mb-6 text-slate-900 dark:text-white relative inline-block">
          تواصل معنا
          <span class="absolute -bottom-2 right-0 w-1/2 h-1 bg-indigo-500 rounded-full"></span>
        </h3>
        <ul class="flex flex-col gap-4">
          <li class="flex items-center gap-3 text-slate-500 dark:text-slate-400">
            <div class="w-8 h-8 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-indigo-500">📞</div>
            <span dir="ltr">+966 50 000 0000</span>
          </li>
          <li class="flex items-center gap-3 text-slate-500 dark:text-slate-400">
            <div class="w-8 h-8 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-indigo-500">✉️</div>
            <span>info@darsni.com</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="pt-8 border-t border-slate-200 dark:border-slate-800 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-slate-500 dark:text-slate-400 text-sm font-semibold">
        جميع الحقوق محفوظة © {new Date().getFullYear()} أكاديمية درسني
      </p>
      
      <div class="flex items-center gap-4">
        <a href="#" class="w-10 h-10 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-500 hover:text-purple-600 hover:bg-purple-100 transition-colors">
          <!-- Twitter Icon -->
          𝕏
        </a>
        <a href="#" class="w-10 h-10 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-500 hover:text-purple-600 hover:bg-purple-100 transition-colors">
          <!-- Instagram Icon -->
          📸
        </a>
      </div>
    </div>
  </div>
</footer>
