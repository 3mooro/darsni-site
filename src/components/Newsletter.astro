<section class="py-24 relative overflow-hidden" dir="rtl">
  <!-- Gradient Background -->
  <div class="absolute inset-0 bg-gradient-to-br from-indigo-900 via-purple-900 to-slate-900"></div>
  <div class="absolute inset-0 opacity-30 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-rose-500 via-transparent to-transparent"></div>
  
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="bg-white/10 dark:bg-slate-900/40 backdrop-blur-xl border border-white/20 rounded-3xl p-10 md:p-16 shadow-2xl text-center">
      <h2 class="text-3xl md:text-5xl font-extrabold text-white mb-6 tracking-tight">اشترك في نشرتنا البريدية</h2>
      <p class="text-indigo-100 mb-10 text-lg max-w-2xl mx-auto">احصل على أحدث النصائح التعليمية، العروض الحصرية، وآخر التحديثات مباشرة في صندوق الوارد الخاص بك.</p>
      
      <form class="max-w-md mx-auto flex flex-col sm:flex-row gap-4">
        <input 
          type="email" 
          placeholder="أدخل بريدك الإلكتروني" 
          required
          class="flex-1 w-full px-6 py-4 rounded-xl bg-white/5 border border-white/10 text-white placeholder-indigo-200 focus:outline-none focus:ring-2 focus:ring-rose-400 focus:border-transparent transition-all"
        />
        <button 
          type="submit" 
          class="px-8 py-4 bg-gradient-to-r from-rose-500 to-purple-600 hover:from-rose-600 hover:to-purple-700 text-white font-bold rounded-xl shadow-lg shadow-purple-500/30 transform hover:-translate-y-1 transition-all duration-300 whitespace-nowrap"
        >
          اشترك الآن
        </button>
      </form>
      <p class="mt-4 text-xs text-indigo-200/60">لن نشارك بريدك الإلكتروني مع أي جهة. يمكنك إلغاء الاشتراك في أي وقت.</p>
    </div>
  </div>
</section>
