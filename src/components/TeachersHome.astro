---
// TeachersHome.astro
const teachers = [
  { name: 'أ. أحمد عبدالله', subject: 'الرياضيات', image: 'https://placehold.co/400x400/4f46e5/ffffff?text=Teacher+1' },
  { name: 'أ. سارة محمد', subject: 'الفيزياء', image: 'https://placehold.co/400x400/9333ea/ffffff?text=Teacher+2' },
  { name: 'أ. خالد سعد', subject: 'اللغة العربية', image: 'https://placehold.co/400x400/e11d48/ffffff?text=Teacher+3' },
  { name: 'أ. نورة العتيبي', subject: 'الكيمياء', image: 'https://placehold.co/400x400/0ea5e9/ffffff?text=Teacher+4' },
];
---

<section class="py-20 relative overflow-hidden" dir="rtl">
  <div class="absolute -top-40 -right-40 w-96 h-96 bg-purple-500/20 rounded-full blur-3xl"></div>
  <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-indigo-500/20 rounded-full blur-3xl"></div>

  <div class="container mx-auto px-4 max-w-7xl relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-4xl font-extrabold text-slate-800 dark:text-white mb-6">
        نخبة من <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-purple-600">المعلمين المتميزين</span>
      </h2>
      <p class="text-xl text-slate-600 dark:text-slate-400">
        تعلم مع أفضل الكفاءات التعليمية المتخصصة لضمان تفوقك.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {teachers.map(teacher => (
        <div class="group relative">
          <div class="absolute inset-0 bg-gradient-to-b from-transparent to-purple-900/90 rounded-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-10"></div>
          <div class="relative rounded-3xl overflow-hidden shadow-lg border border-slate-100 dark:border-slate-800 bg-white dark:bg-slate-900 aspect-[3/4]">
            <img src={teacher.image} alt={teacher.name} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
            <div class="absolute bottom-0 left-0 right-0 p-6 translate-y-4 group-hover:translate-y-0 transition-transform duration-300 z-20">
              <h3 class="text-2xl font-bold text-white text-center drop-shadow-md mb-1">{teacher.name}</h3>
              <p class="text-purple-200 text-center font-medium opacity-0 group-hover:opacity-100 transition-opacity duration-300 delay-100">{teacher.subject}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
