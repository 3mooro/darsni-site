{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-06-28",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "darsni-site",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "darsni-prod-db",
			"database_id": "341cd49b-9974-4fb3-8bd7-35b9ba26e18e"
		}
	]
}